    "privacyPolicy": {
      "title": "Privacy Policy & Data Protection",
      "subtitle": "Pzone's commitment to client confidentiality and data security under Egyptian regulations.",
      "lastUpdated": "Last Updated: August 11, 2026",
      "sec1Title": "1. Overview & Scope",
      "sec1Content": "This policy governs all data collected and processed within the Pzone Water Scope ERP system for swimming pools, fountains, and lagoons, defining how we safeguard client and project information.",
      "sec2Title": "2. Information Collected",
      "sec2Content": "We collect client representative contact info, technical water scope specifications (water area m² & volume m³), contractual & financial figures in EGP, and labor/subcontractor registry records.",
      "sec3Title": "3. Data Security & Technical Protection",
      "sec3Content": "All project data is stored in Supabase PostgreSQL databases enforced by Row Level Security (RLS). Communications and data at rest are encrypted to prevent unauthorized access.",
      "sec4Title": "4. Confidentiality & NDAs",
      "sec4Content": "Pzone enforces strict confidentiality regarding engineering designs, BOQs, and contract values. Water scope drawings and financial estimates are never shared outside contractual execution.",
      "sec5Title": "5. Egyptian Legal Compliance & Third Parties",
      "sec5Content": "Data processing complies with Egyptian Personal Data Protection Law No. 151 of 2020 and Egyptian construction regulations. We guarantee zero selling or commercial sharing of client data.",
      "sec6Title": "6. User Rights & Data Access",
      "sec6Content": "Clients and project stakeholders have the right to request access to registered data, correct inaccuracies, or request archiving of non-contractual records by contacting ERP administration.",
      "navBack": "Back to Projects"
    }
  },
